# ---------------------------------------------------------------------------
# Environment / large binaries
# ---------------------------------------------------------------------------
data/
# external consultation notes, deliberately not versioned
Chatgpt/
__pycache__/
*.pyc
*.npy
*.mat
*.pt

# ---------------------------------------------------------------------------
# Active workspace (CrossFit project). Results are ignored by default; add a
# whitelist entry here once an artifact backs a documented conclusion.
# ---------------------------------------------------------------------------
runs/*

# Phase 0 record: the data audit (sha256, shapes, axis order, env). Small JSON.
!runs/phase0_baseline/
runs/phase0_baseline/*
!runs/phase0_baseline/metadata.json

# ---------------------------------------------------------------------------
# Archived v1 evidence -- SVD-guided sampling (superseded project line).
# The whole run tree including weights stays on disk under archive/, but only
# the artifacts backing documented conclusions are versioned. run -> conclusion
# map in archive/README.md.
# ---------------------------------------------------------------------------
archive/v1_svd_guided_sampling/runs/*
!archive/v1_svd_guided_sampling/runs/*.log
!archive/v1_svd_guided_sampling/runs/*.json

# full-sequence reference volumes and the v1 comparison figures
!archive/v1_svd_guided_sampling/runs/official_mip/
archive/v1_svd_guided_sampling/runs/official_mip/*
!archive/v1_svd_guided_sampling/runs/official_mip/*.png

# phase 3 sampling-selection statistics (SA64 + HSA64 replication)
!archive/v1_svd_guided_sampling/runs/phase3/
archive/v1_svd_guided_sampling/runs/phase3/*
!archive/v1_svd_guided_sampling/runs/phase3/*.json
!archive/v1_svd_guided_sampling/runs/phase3/*.png
!archive/v1_svd_guided_sampling/runs/phase3_hsa64/
archive/v1_svd_guided_sampling/runs/phase3_hsa64/*
!archive/v1_svd_guided_sampling/runs/phase3_hsa64/*.json
!archive/v1_svd_guided_sampling/runs/phase3_hsa64/*.png

# descriptor scan and the independent selector cross-check
!archive/v1_svd_guided_sampling/runs/pattern_scan/
archive/v1_svd_guided_sampling/runs/pattern_scan/*
!archive/v1_svd_guided_sampling/runs/pattern_scan/*.json
!archive/v1_svd_guided_sampling/runs/selector_crosscheck/
archive/v1_svd_guided_sampling/runs/selector_crosscheck/*
!archive/v1_svd_guided_sampling/runs/selector_crosscheck/*.json

# derived volume caches under reports/ are regenerable; the JSON numbers are the evidence
reports/**/*.npz
